# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจาก Firebase Console → Project settings → Your apps (Web)
# ห้าม commit ไฟล์ .env (ถูก ignore ไว้แล้ว) — บน GitHub Actions ใช้ Repository Variables แทน
# ถ้าค่าไม่ครบ แอปจะทำงานแบบ local อย่างเดียว (ไม่ต่อ Firebase)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ตั้งเป็น 1 เพื่อต่อ Firebase Emulator ในเครื่องแทนของจริง (ใช้ตอนพัฒนา/ทดสอบเท่านั้น)
EXPO_PUBLIC_USE_EMULATOR=
